# ---------------------------------------------------------------------
# Local Mama — copy to `.env` and edit. Every value below has a working
# default; the browser demo runs with this file completely untouched.
# ---------------------------------------------------------------------

# --- Local API server -------------------------------------------------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Where leads and transcripts are written.
DATA_DIR=./data


# --- LLM fallback for entity extraction (OPTIONAL) --------------------
# Rules handle the common cases. When a rule match fails, this LLM is asked
# to extract the fields from the utterance. Leave the key blank to run
# rules-only — the demo flow works fine without it.
# Backend: "anthropic" or "openai". The openai backend also speaks to anything
# OpenAI-compatible via LLM_BASE_URL — OpenAI itself, Sarvam's LLM, Groq,
# Together, or a local vLLM/Ollama server. Only two files touch the LLM, so
# switching is a config change, not a rewrite.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=

# --- Gemini (via its OpenAI-compatible endpoint) ----------------------
# Google has invested more heavily in Indic languages than most vendors, so
# Gemini is worth measuring for Telugu/Tamil/Kannada phrasing. It needs no new
# adapter — the openai backend speaks to it directly:
#
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=<your Gemini API key from aistudio.google.com>
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   PHRASING_MODEL=gemini-2.5-flash
#
# Phrasing sits in the live audio path, so pick a *flash*-class model: the
# measured budget is ~1.5s, and anything slower gets discarded by the 2.5s
# timeout and falls back to the template.

LLM_MODEL=claude-opus-5
LLM_EXTRACTION_ENABLED=true

# Natural, free-form phrasing. When on, an LLM rewrites each turn so Mami
# sounds human instead of scripted. The workflow is unaffected: the state
# machine still decides every turn, and each generated line is validated
# against the current state (no premature promises, no invented services or
# cities, no fabricated numbers, right language, voice-safe). Anything that
# fails validation is discarded and the template is spoken instead.
# Off by default — turn it on once you have an API key.
NATURAL_REPLIES=false

# Phrasing runs inside the live audio path, so it is latency-bound, not
# reasoning-bound — the caller hears every second as silence. Measured medians
# for this task: haiku-4.5 1.44s, sonnet-5 2.42s, opus-5 4.04s. Extraction
# (LLM_MODEL above) is off the critical path and stays on the stronger model.
PHRASING_MODEL=claude-haiku-4-5


# --- Returning-caller memory (see caller_profiles.py) -----------------
# Remembers a caller's language and name across calls, so a repeat caller
# skips those questions entirely (measured: 4 caller turns -> 2). Needs a
# stable caller identity, which arrives with telephony (LiveKit SIP); the
# browser demo is anonymous and unaffected.
#
# Phone numbers are never stored: profiles are keyed by a salted hash.
# Rotating PROFILE_SALT orphans every existing profile — that is the
# bulk-forget lever. caller_profiles.forget(number) is the per-caller one.
CALLER_MEMORY=true
PROFILE_SALT=change-me-in-production


# --- STT / TTS providers ----------------------------------------------
# These settings apply to the LiveKit realtime path (backend/app/agent.py).
# The browser test console does not use them — it speaks and listens through
# the Web Speech API, so `mock` keeps that demo working with no keys at all.
#
# STT options: mock | openai | livekit | deepgram | google | sarvam
# TTS options: mock | openai | livekit | cartesia | google | elevenlabs | sarvam
#
# Install the matching plugin for whatever you select, e.g.
#   pip install livekit-plugins-openai livekit-plugins-silero
# `openai` is the default: one key covers both directions, and it is the only
# hosted option whose accent is steerable in free text (see below).
STT_PROVIDER=openai
TTS_PROVIDER=openai

# Sarvam STT language is fixed at construction (its plugin has no
# update_options), so set the language you expect callers to speak. Use
# STT_PROVIDER=deepgram with nova-3 "multi" if you need it to follow a
# mid-call language switch. Ignored by the OpenAI path, which auto-detects and
# is then pinned by the agent once the caller picks a language.
STT_LANGUAGE=en-IN

# --- OpenAI voice models (STT/TTS_PROVIDER=openai) --------------------
# OpenAI ships no Indian voice, and the voice names below are timbre only. The
# Indian accent comes from the free-text `instructions` field of
# gpt-4o-mini-tts, built per language in backend/app/prompts/voice_style.py —
# that is the file to edit if Mami does not sound right. Only gpt-4o-mini-tts
# accepts instructions; the older tts-1 voices are fixed American.
#
# gpt-4o-transcribe is the accurate STT; gpt-4o-mini-transcribe is cheaper and
# slightly faster but noticeably weaker on Indic audio over a phone line.
OPENAI_STT_MODEL=gpt-4o-transcribe
# Stream transcripts over the realtime API rather than uploading each VAD
# segment — partials arrive while the caller is still speaking.
OPENAI_STT_REALTIME=true
# Auto-detect the spoken language until the caller picks one; the agent then
# pins it for the rest of the call, which beats re-detecting on every turn.
OPENAI_STT_DETECT_LANGUAGE=true
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# coral is warm and female, which fits Mami. sage and shimmer are the other two
# worth auditioning.
OPENAI_TTS_VOICE=coral
OPENAI_TTS_SPEED=1.0
# Set to hand-tune the accent. Blank keeps the per-language text, which is what
# follows a mid-call language switch.
OPENAI_TTS_INSTRUCTIONS=

# Provider credentials — only needed for the provider you actually selected.
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
SARVAM_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=


# --- LiveKit (OPTIONAL — only for the realtime voice path) ------------
# Get these from a LiveKit Cloud project or your self-hosted server.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Registering under a name means this worker only takes jobs explicitly
# dispatched to it. An unnamed worker auto-joins EVERY room in the project and
# would hijack any other pipeline on the same LiveKit account.
LIVEKIT_AGENT_NAME=local-mama

# LiveKit Cloud Inference: STT/TTS brokered and billed through LiveKit, so no
# separate vendor key is needed. Use with STT_PROVIDER=livekit TTS_PROVIDER=livekit.
LIVEKIT_STT_MODEL=deepgram/nova-3
LIVEKIT_TTS_MODEL=elevenlabs/eleven_multilingual_v2
# Voice id from the provider's library, e.g. an Indian-English ElevenLabs or
# Cartesia voice. Blank uses the model default, which is usually American or
# British — that is why Mami sounded British out of the box.
LIVEKIT_TTS_VOICE=
# Language hint for multilingual models. "hi" nudges English towards an Indian
# accent on some models; "en" is neutral.
LIVEKIT_TTS_LANGUAGE=en

# --- Turn-taking feel — tune these by ear on a real call ---------------
# How long to wait after the caller stops speaking before answering.
# ENDPOINT_MAX_DELAY was 5.0s, which felt like the agent had died whenever the
# turn detector was unsure. Lower = snappier but more likely to cut people off.
ENDPOINT_MIN_DELAY=0.25
ENDPOINT_MAX_DELAY=1.5
# How much speech is needed to interrupt Mami mid-sentence.
INTERRUPT_MIN_DURATION=0.4

# --- Speech-to-speech worker (agent_realtime.py) ----------------------
# An experiment, not the product: the model decides what to say, so none of the
# state machine's guarantees apply. `make agent` is the real pipeline.
#
# openai | gemini. OpenAI is the default; Gemini is kept for comparison.
REALTIME_PROVIDER=openai

# gpt-realtime hears and speaks directly — no STT or TTS in the loop — so the
# Indian accent has to come from the system prompt. It is appended from
# backend/app/prompts/voice_style.py, the same source as the TTS path.
OPENAI_REALTIME_MODEL=gpt-realtime
# marin and cedar are the newest, most natural voices. Timbre only; none of
# them is Indian on its own.
OPENAI_REALTIME_VOICE=marin
# Semantic VAD eagerness: low waits longer before deciding the caller has
# finished (kinder to speakers who pause between clauses), high answers sooner.
OPENAI_REALTIME_EAGERNESS=auto
# near_field for a phone handset, far_field for a laptop mic.
OPENAI_REALTIME_NOISE_REDUCTION=near_field
OPENAI_REALTIME_SPEED=1.0

# --- Gemini Live turn taking (REALTIME_PROVIDER=gemini) ----------------
# Gemini does its OWN voice-activity detection server-side; the three settings
# above do not apply to it. GEMINI_SILENCE_MS is the main cause of a long gap
# between turns — it is how long Gemini waits in silence before answering.
# Which Live model. Blank = the plugin default, a native-audio model: best
# voice but measured ~6s between turns. The flash-live variant measured
# ~0.5-1s on the same call, but cannot greet first — the caller must speak.
#   GEMINI_REALTIME_MODEL=gemini-3.1-flash-live-preview
GEMINI_REALTIME_MODEL=

GEMINI_SILENCE_MS=500
GEMINI_PREFIX_PADDING_MS=200
GEMINI_END_SENSITIVITY=high
