# Local Mama — two deployables, two sets of variables.
#
# In production these do NOT live in one file: the agent's go to LiveKit and
# the backend's to Render, and neither has the other's. They are together here
# only so one `.env` can run both locally.

# ─────────────────────────────────────────────────────────────────────────────
# AGENT  →  LiveKit Cloud
# ─────────────────────────────────────────────────────────────────────────────

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# No default, deliberately. With one, a laptop running `make agent` against a
# production .env becomes eligible for production dispatch and real callers
# land on it.
LIVEKIT_AGENT_NAME=local-mama

# Where the lead backend lives, and the token it expects. Without both, calls
# are answered and no lead is recorded — reported at startup, not per call.
BACKEND_URL=http://localhost:8000
BACKEND_TOKEN=

# The speech-to-speech model. "openai" | "gemini".
REALTIME_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
# Timbre only — no OpenAI voice is Indian. The accent comes from the prompt.
OPENAI_REALTIME_VOICE=marin
# "high" is minimum dead air; "auto" if callers get answered over mid-thought.
OPENAI_REALTIME_EAGERNESS=high
# "near_field" for a phone handset, "far_field" for a laptop mic.
OPENAI_REALTIME_NOISE_REDUCTION=near_field
OPENAI_REALTIME_SPEED=1.0
# A second, independent decode of the caller's audio. Not for the logs: it is
# the evidence the backend's accuracy audit runs on.
OPENAI_STT_MODEL=gpt-4o-transcribe

# Gemini Live runs its OWN turn detection; the OpenAI settings do not apply.
GOOGLE_API_KEY=
GEMINI_REALTIME_MODEL=
GEMINI_VOICE=Puck
GEMINI_SILENCE_MS=500
GEMINI_PREFIX_PADDING_MS=200
GEMINI_END_SENSITIVITY=high

# Call lifecycle. MAX_CALL_SECONDS is the only thing that ends a call which
# never completes — both the SIP leg and the realtime session bill by the minute.
HANGUP_GRACE_SECONDS=1.5
HANGUP_MAX_WAIT_SECONDS=25
MAX_CALL_SECONDS=600
DRAIN_SECONDS=10

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND  →  Render
# ─────────────────────────────────────────────────────────────────────────────

# Neon. Blank disables every lookup cleanly rather than erroring per call.
DATABASE_URL=

# What the agent presents as a bearer token. Unset refuses everything rather
# than allowing everything.
AGENT_TOKEN=

# Scope within the knowledge base, which is shared with the Vaani bridge.
BRAIN_OWNER_ID=localmama
BRAIN_AGENT_ID=localmama

# Sarvam, for turning captured values into English. Blank falls back to the
# offline transliteration table rather than storing a script nobody reads.
SARVAM_API_KEY=
TRANSLATE_ENABLED=1
TRANSLATE_TIMEOUT=8.0

# WhatsApp handoff. Off until all three are set: a half-configured sender that
# 401s on every lead is worse than an honest "not sent" in the log.
WHATSAPP_ENABLED=0
WHATSAPP_API_KEY=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_LANG_CODE=en_US

# Below this a captured field is flagged for review rather than trusted. Not a
# rejection — the lead is still sent, it just carries a note.
REVIEW_THRESHOLD=0.75
# A transcript is everything the caller said. Personal data under the DPDP Act,
# needed for the audit, and a liability after that. 0 keeps them forever.
TRANSCRIPT_RETENTION_DAYS=30

OUTBOX_SWEEP_SECONDS=300
OUTBOX_MAX_ATTEMPTS=25

LOG_LEVEL=INFO
